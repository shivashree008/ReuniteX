# Copy to .env and fill in values for your local PostgreSQL installation.
PGHOST=localhost
PGPORT=5432
PGDATABASE=reunite_ai
PGUSER=
PGPASSWORD=
CSV_PATH=

# Generate a private value with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OFFICER_USERNAME=
OFFICER_PASSWORD=
MANAGER_USERNAME=
MANAGER_PASSWORD=

# Ollama is optional and must be listening on this computer.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# For a same-machine frontend use 127.0.0.1. For a trusted LAN test only,
# bind to 0.0.0.0 and list exact browser origins below. Use HTTPS for deployment.
HOST=127.0.0.1
LOCAL_DEMO_MODE=false
TRUSTED_CORS_ORIGINS=
OFFLINE_STORE_DIR=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=reunite_ai
DB_USER=postgres
DB_PASSWORD=